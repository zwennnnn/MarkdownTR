{
  "manifest_version": 3,
  "name": "MarkdownTR - Web İçeriği Markdown Çevirici",
  "version": "1.0.0",
  "description": "Kullanıcılar için web sayfalarını ve seçili metinleri Markdown formatına çeviren modern Chrome extension",
  "author": "zwennnnn",
  
    "permissions": [
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "MarkdownTR - Web İçeriği Çevir"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png", 
    "128": "icons/icon128.png"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "popup.css"],
      "matches": ["<all_urls>"]
    }
  ]
} 